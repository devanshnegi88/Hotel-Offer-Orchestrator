                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Full deduplicated, cheapest-price-per-hotel list for a city: parallel supplier fetch -> merge -> Redis."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is a deduplicated array in the expected shape', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    if (body.length > 0) {",
                  "        pm.expect(body[0]).to.have.property('name');",
                  "        pm.expect(body[0]).to.have.property('price');",
                  "        pm.expect(body[0]).to.have.property('supplier');",
                  "        pm.expect(body[0]).to.have.property('commissionPct');",
                  "    }",
                  "});",
                  "pm.test('Hotel names are unique (deduplicated)', function () {",
                  "    const body = pm.response.json();",
                  "    const names = body.map(h => h.name);",
                  "    pm.expect(names.length).to.eql(new Set(names).size);",
                  "});"
                ]
              }
            }
          ]
