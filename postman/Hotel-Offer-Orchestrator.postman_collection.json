      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": "Reports overall health plus Redis / Supplier A / Supplier B reachability."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has status and dependencies', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('status');",
                  "    pm.expect(body).to.have.property('dependencies');",
                  "    pm.expect(body.dependencies).to.have.property('redis');",
                  "    pm.expect(body.dependencies).to.have.property('supplierA');",
                  "    pm.expect(body.dependencies).to.have.property('supplierB');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
